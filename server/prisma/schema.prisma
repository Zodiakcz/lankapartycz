generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  username     String       @unique
  displayName  String
  passwordHash String
  role         String       @default("member") // "admin" | "member"
  approved     Boolean      @default(false)
  createdAt    DateTime     @default(now())

  attendance      Attendance[]
  expenses        Expense[]
  submittedGames  Game[]
  gameVotes       GameVote[]
  entrantsAsUser1 TournamentEntrant[] @relation("EntrantUser1")
  entrantsAsUser2 TournamentEntrant[] @relation("EntrantUser2")
}

model Party {
  id          Int          @id @default(autoincrement())
  name        String
  location    String
  startDate   DateTime
  endDate     DateTime
  description   String       @default("")
  notes         String       @default("") @map("spotifyInfo")
  placeAddress  String       @default("")
  placeStatus     String       @default("pending") // "pending" | "booked" | "confirmed"
  advancePerNight Int          @default(0) // doporučená záloha za noc
  stayPricePerNight Float      @default(0) // cena ubytování za osobonoc
  stayPaidByUserId  Int?       // kdo zaplatil ubytování
  financesLocked    Boolean    @default(false) // uzavřené finance - blokuje úpravy
  createdAt       DateTime     @default(now())

  attendance         Attendance[]
  partyGames         PartyGame[]
  schedule           Schedule[]
  expenses           Expense[]
  packingItems       PackingItem[]
  foodEstimates      FoodEstimate[]
  shoppingItems      ShoppingItem[]
  sentNotifications  SentNotification[]
  tournaments        Tournament[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId    Int
  partyId   Int
  status    String   @default("maybe") // "confirmed" | "maybe" | "declined"
  arrival   DateTime?
  departure DateTime?
  advance     Float    @default(0) // záloha - advance payment
  advancePaid Boolean  @default(false) // záloha zaplacena - confirmed by admin
  settled     Boolean  @default(false) // vyrovnáno - payment confirmed by admin

  user      User     @relation(fields: [userId], references: [id])
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([userId, partyId])
}

model Game {
  id            Int         @id @default(autoincrement())
  name          String
  source        String      @default("steam") // "steam" | "epic" | "copied" | "web"
  sourceNote    String      @default("")
  minPlayers    Int         @default(1)
  maxPlayers    Int?
  imageUrl      String      @default("")
  storeUrl      String      @default("")
  tier          String      @default("silver") // "gold" | "silver" | "bronze" - nové návrhy začínají v bronze
  price         Int?        // cena v Kč, vyplňuje navrhovatel; null = neuvedena (hry z doby před hlasováním)
  submittedById Int?

  submittedBy   User?       @relation(fields: [submittedById], references: [id])
  partyGames    PartyGame[]
  votes         GameVote[]
}

// Hlas = "chci to hrát a koupím si to"
model GameVote {
  id        Int      @id @default(autoincrement())
  gameId    Int
  userId    Int
  createdAt DateTime @default(now())

  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
}

model PartyGame {
  id      Int   @id @default(autoincrement())
  partyId Int
  gameId  Int

  party   Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  game    Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([partyId, gameId])
}

model Schedule {
  id          Int    @id @default(autoincrement())
  partyId     Int
  day         Int    // day number (1, 2, 3...)
  time        String @default("00:00") // "HH:MM" format, e.g. "14:00"
  title       String
  description String @default("")
  gameId      Int?

  party       Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model Expense {
  id          Int    @id @default(autoincrement())
  partyId     Int
  paidByUserId Int
  amount      Float
  description String
  isShared    Boolean @default(true)
  createdAt   DateTime @default(now())

  party       Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  paidBy      User   @relation(fields: [paidByUserId], references: [id])
}

model FoodEstimate {
  id              Int    @id @default(autoincrement())
  partyId         Int
  category        String // "hotova_jidla" | "piti" | "sunky" | "syry" | "zelenina" | "parky" | "toustovy_chleb"
  unit            String @default("ks") // "ks" | "l" | "baleni" | "kg"
  perNight        Float  @default(0) // expected consumption per person per night
  purchased       Boolean @default(false)

  party           Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, category])
}

model ShoppingItem {
  id        Int     @id @default(autoincrement())
  partyId   Int
  name      String
  checked   Boolean @default(false)
  createdAt DateTime @default(now())

  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model PackingItem {
  id       Int     @id @default(autoincrement())
  name     String
  partyId  Int?    // null = global item, set = party-specific
  category String  @default("general") // "general" | "hardware" | "food" | "other"

  party    Party?  @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model SentNotification {
  id        Int      @id @default(autoincrement())
  partyId   Int
  type      String   // "advance_reminder" | "get_ready" | "day_of"
  sentAt    DateTime @default(now())

  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, type])
}

model FaqItem {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Tournament {
  id        Int      @id @default(autoincrement())
  partyId   Int
  name      String
  format    String   @default("1v1") // "1v1" | "2v2"
  status    String   @default("active") // "active" | "complete"
  createdAt DateTime @default(now())

  party     Party               @relation(fields: [partyId], references: [id], onDelete: Cascade)
  entrants  TournamentEntrant[]
  matches   TournamentMatch[]
}

model TournamentEntrant {
  id           Int     @id @default(autoincrement())
  tournamentId Int
  user1Id      Int
  user2Id      Int?
  sittingOut   Boolean @default(false) // 2v2 odd-count: this entrant is a leftover player who sits out

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user1        User       @relation("EntrantUser1", fields: [user1Id], references: [id])
  user2        User?      @relation("EntrantUser2", fields: [user2Id], references: [id])
}

model TournamentMatch {
  id               Int  @id @default(autoincrement())
  tournamentId     Int
  round            Int
  indexInRound     Int
  side1EntrantId   Int?
  side1FromMatchId Int?
  side2EntrantId   Int?
  side2FromMatchId Int?
  winnerEntrantId  Int?

  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}
